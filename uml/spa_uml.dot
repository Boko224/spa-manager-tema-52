digraph UML { graph [rankdir=TB, nodesep=0.6, ranksep=0.9, fontname="DejaVu Sans", labelloc=t, fontsize=20, label="UML клас диаграма - Система за администриране на СПА комплекс\n "];
node [shape=plain, fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=11, color="#333333"];
M [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><B>SpaManager</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- m_name : string<BR/>- m_services : vector&lt;SpaService&gt;<BR/>- m_therapists : vector&lt;TherapistSchedule&gt;<BR/>- m_clients : vector&lt;SpaClient&gt;<BR/>- m_packages : map&lt;string, double&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SpaManager()<BR/>+ SpaManager(name)<BR/>+ get…() / set…() за полетата<BR/>+ registerClient(first, middle, phone, package, stayStart)<BR/>+ bookProcedure(clientIndex, service, therapist, start)<BR/>+ toggleBreak(therapistIndex)<BR/>+ occupancyAt(service, minute) : int<BR/>+ getServicesSorted(byRevenue) : vector&lt;SpaService&gt;<BR/>+ printReport(out)<BR/>+ save()<BR/>+ load()</TD></TR></TABLE>>];
S [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><B>SpaService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- m_name : string<BR/>- m_type : ServiceType<BR/>- m_duration : int<BR/>- m_price : double<BR/>- m_capacity : int<BR/>- m_needsTherapist : bool<BR/>- m_timesBooked : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SpaService()<BR/>+ SpaService(name, type, duration, price, capacity, needsTherapist)<BR/>+ get…() / set…() за полетата<BR/>+ getRevenue() : double<BR/>+ getTypeName() : string<BR/>+ addSale()</TD></TR></TABLE>>];
C [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><B>SpaClient</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- m_firstName : string<BR/>- m_middleName : string<BR/>- m_phone : string<BR/>- m_package : string<BR/>- m_packagePrice : double<BR/>- m_bookings : vector&lt;Booking&gt;<BR/>- m_stayStart : int<BR/>- m_bill : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SpaClient()<BR/>+ SpaClient(first, middle, phone, package, packagePrice, stayStart)<BR/>+ get…() / set…() за полетата<BR/>+ isBusy(start, end) : bool<BR/>+ addBooking(booking)<BR/>+ operator&lt;&lt;(out, client) {friend}</TD></TR></TABLE>>];
T [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><B>TherapistSchedule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- m_name : string<BR/>- m_specialty : string<BR/>- m_slots : vector&lt;pair&lt;int, int&gt;&gt;<BR/>- m_status : TherapistStatus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ TherapistSchedule()<BR/>+ TherapistSchedule(name, specialty)<BR/>+ get…() / set…() за полетата<BR/>+ getStatusName() : string<BR/>+ reserve(start, end)</TD></TR></TABLE>>];
B [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><FONT POINT-SIZE="10">«struct»</FONT><BR/><B>Booking</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ service : string<BR/>+ therapist : string<BR/>+ start : int<BR/>+ end : int<BR/>+ price : double</TD></TR></TABLE>>];
ST [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><FONT POINT-SIZE="10">«enum class»</FONT><BR/><B>ServiceType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Massage<BR/>Sauna<BR/>ThermalPool<BR/>Therapy</TD></TR></TABLE>>];
TS [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><FONT POINT-SIZE="10">«enum class»</FONT><BR/><B>TherapistStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Free<BR/>Busy<BR/>OnBreak</TD></TR></TABLE>>];
E [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><B>SpaException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SpaException(message)</TD></TR></TABLE>>];
R [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#DCE6F2"><B>std::runtime_error</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
M -> S [dir=both, arrowtail=diamond, arrowhead=vee, taillabel="1", headlabel="0..*", labeldistance=2.2];
M -> C [dir=both, arrowtail=diamond, arrowhead=vee, taillabel="1", headlabel="0..*", labeldistance=2.2];
M -> T [dir=both, arrowtail=diamond, arrowhead=vee, taillabel="1", headlabel="0..*", labeldistance=2.2];
C -> B [dir=both, arrowtail=diamond, arrowhead=vee, taillabel="1", headlabel="0..*", labeldistance=2.2];
S -> ST [style=dashed, arrowhead=vee, label="«use»"];
T -> TS [style=dashed, arrowhead=vee, label="«use»"];
M -> E [style=dashed, arrowhead=vee, label="«throw»"];
T -> E [style=dashed, arrowhead=vee, label="«throw»"];
R -> E [dir=back, arrowtail=empty];
{rank=same; S; C; T;}
}
